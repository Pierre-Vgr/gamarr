# Chemin ABSOLU, sur la machine hôte, vers le dossier contenant tes jeux non installés.
# Monté en lecture seule dans le conteneur sur /games.
GAMES_PATH=/home/toi/Games

# Clé API gratuite sur https://rawg.io/apidocs
RAWG_API_KEY=

# Optionnel : identifiants Twitch Developer pour activer IGDB
# https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
